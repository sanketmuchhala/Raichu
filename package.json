{
  "name": "raichu",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:ios": "bash scripts/build-ios-engine.sh",
    "build:ios:minify": "bash scripts/build-ios-engine.sh --minify",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "check:supabase": "pnpm --filter @raichu/api exec tsx scripts/check-supabase.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "path-to-regexp@<0.1.13": "0.1.13",
      "picomatch@^2": "2.3.2",
      "picomatch@^4": "4.0.4",
      "vite": "^6.4.2",
      "postcss@<8.5.10": "8.5.14"
    }
  }
}
