# Supabase (get these from your Supabase project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Server-only. Required by the analytics ingestion route (src/app/api/track/route.ts).
# Without it every tracked event fails with a 500.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Express API base URL. next.config.js rewrites /api/* to this host.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Canonical site URL, used for SEO metadata in src/lib/seo.ts
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only salt used to hash visitor IPs before they are stored.
# Generate with: openssl rand -hex 32
ANALYTICS_IP_SALT=change-me

# Comma-separated profile ids allowed to view /admin/analytics.
# Find yours with: select id, username from profiles;
ADMIN_USER_IDS=
